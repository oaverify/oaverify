{
  "name": "@oaverify/check",
  "version": "7.2.1",
  "description": "The composed OpenAPI document check behind `oaverify check`: hygiene, schema, conformance, example and ReDoS passes over a resolved spec, graded into one finding list.",
  "keywords": [
    "oas",
    "openapi",
    "openapi-3.0",
    "openapi-3.1",
    "openapi-3.2",
    "openapi-lint",
    "openapi-validator",
    "sarif",
    "spec-lint",
    "swagger",
    "validation",
    "validator"
  ],
  "homepage": "https://github.com/oaverify/oaverify#readme",
  "bugs": {
    "url": "https://github.com/oaverify/oaverify/issues"
  },
  "license": "MIT",
  "author": "Andrew Houghton <aah@roarmouse.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaverify/oaverify.git",
    "directory": "packages/check"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "prepack": "node -e \"if((process.env.npm_config_user_agent||'').startsWith('npm/'))throw Error('Use pnpm pack: npm pack does not rewrite workspace:* deps.')\" && tsup && node ../../scripts/pack-devdeps.mjs strip",
    "postpack": "node ../../scripts/pack-devdeps.mjs restore"
  },
  "dependencies": {
    "@oaverify/core": "workspace:*",
    "redos-detector": "^6.1.4"
  },
  "devDependencies": {
    "@oaverify/internal-core": "workspace:*",
    "@oaverify/internal-formats": "workspace:*",
    "@oaverify/internal-metaschema": "workspace:*",
    "@oaverify/internal-schema": "workspace:*",
    "@oaverify/internal-spec": "workspace:*",
    "@oaverify/internal-validator": "workspace:*",
    "@oaverify/syntax": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "//": "No prepublishOnly: release.yml runs `pnpm test` from root, then packs with `pnpm pack` and publishes each tarball with `npm publish <tarball>`, which does not run prepublishOnly at all. Per-package publish (`cd packages/<x> && pnpm publish`) is not the supported path; it would skip the test gate."
}
