{
  "name": "@oaverify/express5",
  "version": "3.8.0",
  "description": "Express 5 middleware for OpenAPI request validation (3.0/3.1/3.2). Promise-native; checks the request against your spec and returns problem+json errors. Built on @oaverify/core.",
  "keywords": [
    "api-validation",
    "express",
    "express-openapi",
    "express5",
    "middleware",
    "oas",
    "openapi",
    "openapi-3.0",
    "openapi-3.1",
    "openapi-3.2",
    "openapi-middleware",
    "openapi-request-validator",
    "openapi-validator",
    "request-validator",
    "swagger",
    "validation",
    "validator"
  ],
  "homepage": "https://github.com/oaverify/oaverify#readme",
  "bugs": {
    "url": "https://github.com/oaverify/oaverify/issues"
  },
  "license": "MIT",
  "author": "Andrew Houghton <aah@roarmouse.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaverify/oaverify.git",
    "directory": "packages/oav-express5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "prepack": "node -e \"if((process.env.npm_config_user_agent||'').startsWith('npm/'))throw Error('Use pnpm pack: npm pack does not rewrite workspace:* deps.')\" && tsup && node ../../scripts/pack-devdeps.mjs strip",
    "postpack": "node ../../scripts/pack-devdeps.mjs restore"
  },
  "dependencies": {
    "@oaverify/core": "workspace:*"
  },
  "devDependencies": {
    "@oaverify/internal-core": "workspace:*",
    "@oaverify/internal-validator": "workspace:*",
    "@types/express": "5.0.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "//": "No prepublishOnly: release.yml runs `pnpm test` from root before `pnpm -r publish`. Per-package publish (`cd packages/<x> && pnpm publish`) is not the supported path; it would skip the test gate."
}
