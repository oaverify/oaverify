{
  "name": "@oaverify/internal-validator",
  "version": "0.0.0",
  "private": true,
  "description": "Internal: HTTP request/response validator orchestrator for oaverify.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./internals": {
      "types": "./src/internals.ts",
      "import": "./src/internals.ts"
    },
    "./codegen-runtime": {
      "types": "./src/codegen-runtime.ts",
      "import": "./src/codegen-runtime.ts"
    }
  },
  "dependencies": {
    "@oaverify/internal-core": "workspace:*",
    "@oaverify/internal-formats": "workspace:*",
    "@oaverify/internal-router": "workspace:*",
    "@oaverify/internal-schema": "workspace:*",
    "@oaverify/internal-spec": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
