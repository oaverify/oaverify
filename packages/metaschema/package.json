{
  "name": "@oaverify/internal-metaschema",
  "version": "0.0.0",
  "private": true,
  "description": "Internal: the published OpenAPI meta-schemas, pinned per version, plus the dispatch that picks one for a document.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./conformance": {
      "types": "./src/conformance.ts",
      "import": "./src/conformance.ts"
    }
  },
  "dependencies": {
    "@oaverify/internal-core": "workspace:*",
    "@oaverify/internal-schema": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
