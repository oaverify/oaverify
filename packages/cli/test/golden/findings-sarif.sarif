      "results": [
        {
          "ruleId": "format-not-validated",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "\"not-a-real-format\" is not a format oaverify validates, so values are checked against \"type\" alone. This is legal: support for a format is optional and a tool may fall back to \"type\" for one it does not recognise. Register a validator through the formats option to enforce it, or read this as confirmation the name is an annotation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "shared.json",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "relatedLocations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "entry.json",
                  "uriBaseId": "%SRCROOT%"
