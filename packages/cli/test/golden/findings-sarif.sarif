{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "oaverify",
          "informationUri": "https://github.com/oaverify/oaverify",
          "version": "0.0.0-golden",
          "semanticVersion": "0.0.0-golden",
          "rules": [
            {
              "id": "format-not-validated",
              "name": "format-not-validated",
              "shortDescription": {
                "text": "format-not-validated"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "oaverify:class": "schema",
                "tags": [
                  "schema"
                ]
              }
            },
            {
              "id": "type",
              "name": "type",
              "shortDescription": {
                "text": "type"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "oaverify:class": "conformance",
                "tags": [
                  "conformance"
                ]
              }
            },
            {
              "id": "example-invalid",
              "name": "example-invalid",
              "shortDescription": {
                "text": "example-invalid"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "oaverify:class": "examples",
                "tags": [
                  "examples"
                ]
              }
            },
            {
              "id": "ambiguous-pattern",
              "name": "ambiguous-pattern",
              "shortDescription": {
                "text": "ambiguous-pattern"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "oaverify:class": "redos",
                "tags": [
                  "redos"
                ]
              }
            },
            {
