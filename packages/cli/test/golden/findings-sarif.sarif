          "partialFingerprints": {
            "oaverifyFindingV1": "type entry.json/paths/~1status/get/responses/202/description"
          },
          "properties": {
            "oaverify:class": "conformance",
            "oaverify:severity": "error",
            "oaverify:location": "/paths/~1status/get/responses/202/description",
            "oaverify:pointer": "/paths/~1status/get/responses/202/description",
            "oaverify:anchor": "node",
            "oaverify:sourcePointer": "/paths/~1status/get/responses/202/description"
          }
        },
        {
          "ruleId": "example-invalid",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "oaverify rejects \"example\" against its schema: must be one of the allowed values (actual: \"EFT\", allowed: [\"ACH\",\"CHECK\"]) (example: \"EFT\")"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "entry.json",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "partialFingerprints": {
            "oaverifyFindingV1": "example-invalid entry.json/paths/~1search/post/requestBody/content/application~1json/example"
          },
          "properties": {
            "oaverify:class": "examples",
            "oaverify:severity": "warning",
            "oaverify:location": "/paths/~1search/post/requestBody/content/application~1json/example",
            "oaverify:pointer": "/paths/~1search/post/requestBody/content/application~1json/example",
            "oaverify:anchor": "node",
            "oaverify:sourcePointer": "/paths/~1search/post/requestBody/content/application~1json/example"
          }
        },
        {
          "ruleId": "ambiguous-pattern",
          "ruleIndex": 3,
          "level": "warning",
          "message": {
            "text": "\"^(a+)+$\" is ambiguous. An input of the form `aaaa` matches more than one way. A backtracking engine can be made to explore every way of matching, so a crafted value may cost superlinear time; whether it does depends on the engine running the pattern. Rewrite to remove the ambiguity, or compile patterns with a linear-time engine (the regexCompiler option)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "shared.json",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "relatedLocations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "entry.json",
                  "uriBaseId": "%SRCROOT%"
                }
              },
              "message": {
                "text": "reference 1 of 1 the resolver followed to reach this document: /paths/~1pets~1{petId}/get/responses/200/content/application~1json/schema"
              }
            }
          ],
          "partialFingerprints": {
            "oaverifyFindingV1": "ambiguous-pattern shared.json/Pet/properties/slug/pattern"
          },
          "properties": {
            "oaverify:class": "redos",
            "oaverify:severity": "warning",
            "oaverify:location": "/components/schemas/shared_Pet/properties/slug/pattern",
            "oaverify:pointer": "/components/schemas/shared_Pet/properties/slug/pattern",
            "oaverify:anchor": "node",
            "oaverify:sourcePointer": "/Pet/properties/slug/pattern"
          }
        },
        {
          "ruleId": "silent-rewrite/required-not-in-properties",
          "ruleIndex": 4,
          "level": "warning",
          "message": {
            "text": "required: \"absent\" at <root> is not declared in properties reachable here (likely a typo)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "shared.json",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "relatedLocations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "entry.json",
                  "uriBaseId": "%SRCROOT%"
                }
              },
              "message": {
                "text": "reference 1 of 1 the resolver followed to reach this document: /paths/~1pets~1{petId}/get/responses/200/content/application~1json/schema"
              }
            }
          ],
          "partialFingerprints": {
            "oaverifyFindingV1": "silent-rewrite/required-not-in-properties shared.json/Pet/required"
          },
          "properties": {
            "oaverify:class": "schema",
            "oaverify:severity": "warning",
            "oaverify:location": "GET /pets/{petId} 200 response body (application/json) -> <root>",
