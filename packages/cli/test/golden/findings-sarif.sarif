      },
      "properties": {
        "oaverify:classes": [
          "conformance",
          "examples",
          "hygiene",
          "redos",
          "schema"
        ]
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "level": "note",
              "message": {
                "text": "--findings -hygiene suppressed 2 finding(s); they are absent from this log."
              },
              "descriptor": {
                "id": "oaverify:skipped"
              },
              "properties": {
                "oaverify:skipKey": "-hygiene",
                "oaverify:skipCount": 2
              }
            },
            {
              "level": "note",
              "message": {
                "text": "--findings -unused-tag changed nothing (already excluded by another term)."
              },
              "descriptor": {
                "id": "oaverify:noop-term"
              },
              "properties": {
                "oaverify:term": "-unused-tag",
                "oaverify:reason": "already excluded by another term"
              }
            }
          ]
        }
