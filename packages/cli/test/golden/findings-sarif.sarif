          "partialFingerprints": {
            "oaverifyFindingV1": "format-not-validated shared.json/Pet/properties/ref/format"
          },
          "properties": {
            "oaverify:class": "schema",
            "oaverify:severity": "warning",
            "oaverify:location": "/components/schemas/shared_Pet/properties/ref/format",
            "oaverify:pointer": "/components/schemas/shared_Pet/properties/ref/format",
            "oaverify:anchor": "node",
            "oaverify:sourcePointer": "/Pet/properties/ref/format"
