          "ruleIndex": 5,
          "level": "warning",
          "message": {
            "text": "\"pattern\" \"^[0-9]{5}$\" at \"properties.code\" matches only strings of length 5, so \"maxLength\": 2 can never be satisfied; no string validates here"
          },
          "locations": [
            {
