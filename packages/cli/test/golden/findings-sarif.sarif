              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "oaverify:class": "schema",
                "tags": [
                  "schema"
                ]
              }
            },
            {
              "id": "unsatisfiable/pattern-length",
              "name": "unsatisfiable/pattern-length",
              "shortDescription": {
                "text": "unsatisfiable/pattern-length"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "oaverify:class": "schema",
                "tags": [
                  "schema"
                ]
              }
