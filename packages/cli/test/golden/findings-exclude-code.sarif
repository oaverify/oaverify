{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "oaverify",
          "informationUri": "https://github.com/oaverify/oaverify",
          "version": "0.0.0-golden",
          "semanticVersion": "0.0.0-golden",
          "rules": [
            {
              "id": "path-param-undeclared",
              "name": "path-param-undeclared",
              "shortDescription": {
                "text": "a path template placeholder with no parameter declaring it"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "oaverify:class": "hygiene",
                "tags": [
                  "hygiene"
                ]
              }
            },
            {
              "id": "format-not-validated",
              "name": "format-not-validated",
              "shortDescription": {
                "text": "a format name with no validator behind it"
              },
              "fullDescription": {
                "text": "Values carrying this format are checked against \"type\" alone. That is legal: support for any given format is optional, and a validator may fall back to \"type\" for one it does not recognise. Register a validator for the name through the formats option to enforce it, or read this finding as confirmation that the name is documentation rather than a constraint."
              },
              "help": {
                "text": "Values carrying this format are checked against \"type\" alone. That is legal: support for any given format is optional, and a validator may fall back to \"type\" for one it does not recognise. Register a validator for the name through the formats option to enforce it, or read this finding as confirmation that the name is documentation rather than a constraint."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "oaverify:class": "schema",
                "tags": [
                  "schema"
                ]
              }
            },
            {
              "id": "type",
              "name": "type",
              "shortDescription": {
                "text": "a field with the wrong JSON type"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "oaverify:class": "conformance",
                "tags": [
                  "conformance"
                ]
              }
            },
            {
              "id": "example-invalid",
              "name": "example-invalid",
              "shortDescription": {
                "text": "an example the schema it illustrates rejects"
              },
              "fullDescription": {
                "text": "Every example in the document is validated against the schema it sits in. An example reached through a $ref is checked once at the component that declares it rather than at each use site, so one finding can stand for many references. The message names up to five distinct reasons and then counts the rest; the finding's reasons field carries every rejected leaf, uncapped and unabbreviated."
              },
              "help": {
                "text": "Every example in the document is validated against the schema it sits in. An example reached through a $ref is checked once at the component that declares it rather than at each use site, so one finding can stand for many references. The message names up to five distinct reasons and then counts the rest; the finding's reasons field carries every rejected leaf, uncapped and unabbreviated."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "oaverify:class": "examples",
                "tags": [
                  "examples"
                ]
              }
            },
            {
              "id": "ambiguous-pattern",
              "name": "ambiguous-pattern",
              "shortDescription": {
                "text": "a pattern whose matching can blow up on crafted input"
              },
              "fullDescription": {
                "text": "A backtracking engine can be made to explore every way an ambiguous pattern matches, so an input crafted against it can take superlinear time. Whether a given pattern actually costs that depends on the engine running it, which is not known here. Rewrite the pattern to remove the ambiguity, or compile patterns with a linear-time engine through the regexCompiler option."
              },
              "help": {
                "text": "A backtracking engine can be made to explore every way an ambiguous pattern matches, so an input crafted against it can take superlinear time. Whether a given pattern actually costs that depends on the engine running it, which is not known here. Rewrite the pattern to remove the ambiguity, or compile patterns with a linear-time engine through the regexCompiler option."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "oaverify:class": "redos",
                "tags": [
                  "redos"
                ]
              }
            },
            {
              "id": "silent-rewrite/required-not-in-properties",
              "name": "silent-rewrite/required-not-in-properties",
              "shortDescription": {
                "text": "a required property name nothing at that position can produce"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "oaverify:class": "schema",
                "tags": [
                  "schema"
                ]
              }
            },
            {
              "id": "unsatisfiable/pattern-length",
              "name": "unsatisfiable/pattern-length",
              "shortDescription": {
                "text": "a pattern and a length bound no string satisfies together"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "oaverify:class": "schema",
                "tags": [
                  "schema"
                ]
              }
            }
          ]
        }
      },
      "properties": {
        "oaverify:classes": [
          "conformance",
          "examples",
          "hygiene",
          "redos",
          "schema"
        ]
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "level": "note",
              "message": {
                "text": "--findings -unused-component suppressed 1 finding(s); they are absent from this log."
              },
              "descriptor": {
                "id": "oaverify:skipped"
              },
              "properties": {
                "oaverify:skipKey": "-unused-component",
                "oaverify:skipCount": 1
              }
            }
          ]
        }
      ],
      "results": [
        {
          "ruleId": "path-param-undeclared",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "path template \"/pets/{petId}\" references \"{petId}\" but neither the operation nor its path item declares a path parameter named \"petId\""
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "entry.json",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "partialFingerprints": {
            "oaverifyFindingV1": "path-param-undeclared entry.json/paths/~1pets~1{petId}/get"
          },
          "properties": {
            "oaverify:class": "hygiene",
            "oaverify:severity": "error",
            "oaverify:location": "/paths/~1pets~1{petId}/get",
            "oaverify:pointer": "/paths/~1pets~1{petId}/get",
            "oaverify:anchor": "node",
            "oaverify:sourcePointer": "/paths/~1pets~1{petId}/get"
          }
        },
        {
          "ruleId": "format-not-validated",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "\"not-a-real-format\" is not a validated format, so values are checked against \"type\" alone."
          },
          "locations": [
