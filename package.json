{
  "name": "@oaverify/core",
  "version": "7.1.0",
  "description": "Zero-dependency OpenAPI request/response validator (3.0/3.1/3.2) for TypeScript, Node, and edge/serverless runtimes.",
  "keywords": [
    "api-validation",
    "http",
    "json-schema",
    "json-schema-2020-12",
    "json-schema-validator",
    "oas",
    "openapi",
    "openapi-3.0",
    "openapi-3.1",
    "openapi-3.2",
    "openapi-request-validator",
    "openapi-response-validator",
    "openapi-validator",
    "openapi3",
    "request-validator",
    "response-validator",
    "schema",
    "swagger",
    "swagger-validator",
    "validation",
    "validator"
  ],
  "homepage": "https://github.com/oaverify/oaverify#readme",
  "bugs": {
    "url": "https://github.com/oaverify/oaverify/issues"
  },
  "license": "MIT",
  "author": "Andrew Houghton <aah@roarmouse.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaverify/oaverify.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/schema.cjs"
      }
    },
    "./schema/internals": {
      "import": {
        "types": "./dist/schema-internals.d.ts",
        "default": "./dist/schema-internals.js"
      },
      "require": {
        "types": "./dist/schema-internals.d.cts",
        "default": "./dist/schema-internals.cjs"
      }
    },
    "./spec": {
      "import": {
        "types": "./dist/spec.d.ts",
        "default": "./dist/spec.js"
      },
      "require": {
        "types": "./dist/spec.d.cts",
        "default": "./dist/spec.cjs"
      }
    },
    "./spec/internals": {
      "import": {
        "types": "./dist/spec-internals.d.ts",
        "default": "./dist/spec-internals.js"
      },
      "require": {
        "types": "./dist/spec-internals.d.cts",
        "default": "./dist/spec-internals.cjs"
      }
    },
    "./overlay-spec": {
      "import": {
        "types": "./dist/overlay-spec.d.ts",
        "default": "./dist/overlay-spec.js"
      },
      "require": {
        "types": "./dist/overlay-spec.d.cts",
        "default": "./dist/overlay-spec.cjs"
      }
    },
    "./formats": {
      "import": {
        "types": "./dist/formats.d.ts",
        "default": "./dist/formats.js"
      },
      "require": {
        "types": "./dist/formats.d.cts",
        "default": "./dist/formats.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./validator/internals": {
      "import": {
        "types": "./dist/validator-internals.d.ts",
        "default": "./dist/validator-internals.js"
      },
      "require": {
        "types": "./dist/validator-internals.d.cts",
        "default": "./dist/validator-internals.cjs"
      }
    },
    "./codegen-runtime": {
      "import": {
        "types": "./dist/codegen-runtime.d.ts",
        "default": "./dist/codegen-runtime.js"
      },
      "require": {
        "types": "./dist/codegen-runtime.d.cts",
        "default": "./dist/codegen-runtime.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && pnpm --filter @oaverify/stream build && pnpm --filter @oaverify/syntax build && pnpm --filter @oaverify/check build && pnpm --filter oaverify build",
    "oaverify": "node packages/oav/dist/cli.js",
    "test": "vitest run",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm lint:type-aware",
    "test:coverage": "vitest run --coverage",
    "coverage:by-package": "node ./scripts/coverage-by-package.mjs",
    "grid-check": "node ./scripts/grid-check.mjs",
    "grid:dump": "node ./scripts/grid/dump.mjs",
    "grid:diff": "node ./scripts/grid/diff.mjs",
    "test:watch": "vitest",
    "lint": "oxlint && oxfmt --check . && pnpm check:deps && pnpm check:release && pnpm check:walkers",
    "check:release": "node ./scripts/check-release-lists.mjs",
    "check:walkers": "node ./scripts/check-subschema-walkers.mjs",
    "lint:type-aware": "oxlint --type-aware -c .oxlintrc.type-aware.json packages",
    "check:deps": "node ./scripts/check-deps.mjs",
    "metaschema:stale": "node ./packages/metaschema/scripts/check-drift.mjs",
    "fmt": "oxfmt --write .",
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "tsc -b && tsc -p examples && tsc -p tsconfig.tests.json",
    "prepack": "pnpm build && node ./scripts/pack-devdeps.mjs strip",
    "postpack": "node ./scripts/pack-devdeps.mjs restore",
    "prepublishOnly": "pnpm test"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
