{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-v-in-tag": true,
  "include-component-in-tag": true,
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "oaverify",
      "components": ["core", "oaverify", "yaml", "express4", "express5", "fastify"]
    }
  ],
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": false
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chore",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "@oaverify/core",
      "component": "core",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/oav": {
      "release-type": "node",
      "package-name": "oaverify",
      "component": "oaverify",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/yaml": {
      "release-type": "node",
      "package-name": "@oaverify/yaml",
      "component": "yaml",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/oav-express4": {
      "release-type": "node",
      "package-name": "@oaverify/express4",
      "component": "express4",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/oav-express5": {
      "release-type": "node",
      "package-name": "@oaverify/express5",
      "component": "express5",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/oav-fastify": {
      "release-type": "node",
      "package-name": "@oaverify/fastify",
      "component": "fastify",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/stream-validator": {
      "release-type": "node",
      "package-name": "@oaverify/stream",
      "component": "stream",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true
    }
  }
}
